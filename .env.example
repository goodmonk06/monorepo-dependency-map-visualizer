# Monorepo Dependency Map Visualizer Configuration

# Node Environment
NODE_ENV=development

# UI Server Port (for local development)
UI_PORT=3000

# Analysis Output Directory
ANALYSIS_OUTPUT_DIR=./analysis

# Config File Path (optional - defaults to monorepo-map.config.json)
# CONFIG_PATH=./monorepo-map.config.json

# Target Monorepo Path (for Docker usage)
# TARGET_MONOREPO=/workspace
